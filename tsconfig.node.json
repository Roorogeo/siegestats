{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "types": ["node", "electron-vite/node"],
    "allowImportingTsExtensions": true,
    "outDir": "./node_modules/.tmp/node"
  },
  "include": [
    "src/main", "src/preload", "src/shared", "src/core", "config/**/*.json", "build",
    "tests/unit", "tests/unit/**/*.json", "package.json", "electron.vite.config.ts", "vite.web.config.ts", "vitest.config.ts", "playwright.config.ts"
  ]
}
