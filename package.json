{
  "name": "sightline",
  "productName": "Sightline",
  "version": "0.1.0",
  "description": "Fan-made desktop companion for Rainbow Six Siege players. Not affiliated with or endorsed by Ubisoft.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Sightline",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && npm run build:web && playwright test --trace off",
    "check": "npm run typecheck && npm run lint && npm run test",
    "themes:report": "node scripts/theme-report.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "electron-store": "12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.107.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "clsx": "2.1.1",
    "electron": "44.9.3",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
